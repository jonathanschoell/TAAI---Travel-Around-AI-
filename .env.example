# Copy to .env.local for local development. In production, set these in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. Server only. Used for account deletion and the admin area.
SUPABASE_SECRET_KEY=

# Comma-separated email addresses that may open /admin (must be confirmed accounts).
ADMIN_EMAILS=

# Public address of the site, without trailing slash, e.g. https://taai.example
NEXT_PUBLIC_SITE_URL=
