# Copy to .env.local for local development. In production, set these in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. Server only. Used for account deletion and the admin area.
SUPABASE_SECRET_KEY=

# Comma-separated email addresses that may open /admin (must be confirmed accounts).
ADMIN_EMAILS=

# Public address of the site, without trailing slash, e.g. https://jovia.example
NEXT_PUBLIC_SITE_URL=

# Anthropic API key for the AI trip planner (console.anthropic.com). Server only.
ANTHROPIC_API_KEY=
# Optional: override the model used for itineraries.
# ANTHROPIC_MODEL=claude-sonnet-5-5
